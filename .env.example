# ──────────────────────────────────────────────────────────────
# BEAN-Autopilot — CORE-03G Live AI Providers configuration
# ──────────────────────────────────────────────────────────────
# This file lists CONFIGURATION NAMES only. It never contains real
# secrets. Copy to `.env` (or set these in your deployment environment)
# and fill in values server-side. Credentials are read ONLY from the
# server-side environment and are never committed, logged, or sent to
# the browser.

# ── BEAN Intelligence gateway (native adapter) ─────────────────
# Base URL of the BEAN Intelligence public gateway (documented /api/v1
# surface). Must be an http(s) absolute URL with no credentials, query
# string, or fragment.
BEAN_INTELLIGENCE_BASE_URL=
# API key (Bearer bgk_...). Read server-side only.
BEAN_INTELLIGENCE_API_KEY=

# ── OpenAI-compatible endpoint (generic adapter) ───────────────
# Base URL of any OpenAI Chat-Completions-compatible endpoint.
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_API_KEY=
# The model id this endpoint serves (the `model` field in requests).
OPENAI_COMPATIBLE_MODEL=

# ── Local inference (optional, opt-in) ────────────────────────
# Base URL of a locally-hosted inference server (Ollama / LM Studio /
# vLLM OpenAI shim). Local endpoints are ONLY permitted when
# BEAN_AI_ALLOW_LOCAL_ENDPOINTS is explicitly enabled.
LOCAL_INFERENCE_BASE_URL=
LOCAL_INFERENCE_MODEL=
# Required to dial loopback / private hosts. Without this, local
# endpoints are blocked by endpoint safety (SSRF guard) and the local
# provider is registered CONFIGURATION_REQUIRED.
BEAN_AI_ALLOW_LOCAL_ENDPOINTS=

# ── Database ───────────────────────────────────────────────────
# SQLite path (default: in-memory in dev). PostgreSQL is the documented
# production target (ADR-002).
BEAN_DB_PATH=
